#import,dir "../.";
#import "Basic";
main :: () {
   //this example was generated by AI.
    zip_path := "assets/test1.zip";

    // 1. Zero-initialize the archive tracker struct
    zip: mz_zip_archive;

    // 2. Open the ZIP container file pointer
    // temp_c_string transforms the Jai string view into a null-terminated pointer for C
    if !mz_zip_reader_init_file(*zip, temp_c_string(zip_path), 0) {
        log_error("Could not open ZIP archive file: %, probably wrong path.", zip_path);
        return;
    }
    defer mz_zip_reader_end(*zip); // Automatically close file descriptors when main finishes

    // 3. Query the central directory for the file count
    total_files := mz_zip_reader_get_num_files(*zip);
    print("Archive '%' opened successfully. Found % entries.\n\n", zip_path, total_files);

    // 4. Iterate over every individual entry
    for i: 0..total_files-1 {
        stat: mz_zip_archive_file_stat;

        if !mz_zip_reader_file_stat(*zip, xx i, *stat) {
            log_error("Failed to read details for entry index %", i);
            continue;
        }

        // Convert the C character array back into a safe, clean Jai string view
        filename_string: string;
        filename_string.data = stat.m_filename.data;
        filename_string.count = c_style_strlen(stat.m_filename.data);

        // Check if the entry is an organizational directory or an extractable asset
        is_dir := mz_zip_reader_is_file_a_directory(*zip, xx i);

        if is_dir {
            print("[FOLDER] %\n", filename_string);
        } else {
            print("[FILE]   % (% bytes uncompressed)\n", filename_string, stat.m_uncomp_size);
        }
    }
}
